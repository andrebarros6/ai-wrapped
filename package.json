{
  "name": "ai-wrapped",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "gen:sql": "node scripts/gen-sql.mjs",
    "vendor:duckdb": "node scripts/vendor-duckdb.mjs",
    "predev": "npm run gen:sql && npm run vendor:duckdb",
    "dev": "next dev",
    "prebuild": "npm run gen:sql && npm run vendor:duckdb",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "npm run gen:sql && next typegen && tsc --noEmit",
    "pretest": "npm run gen:sql",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "playwright test -c playwright.live.config.ts"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@vercel/analytics": "2.0.1",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "jszip": "3.10.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
